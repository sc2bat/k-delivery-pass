<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.baedal.pass.mapper.CategoryMapper">

    <select id="findAll" resultType="com.baedal.pass.domain.Category">
        SELECT 
            id,
            name,
            icon_url,
            is_active
        FROM categories
        WHERE is_active = TRUE
        ORDER BY id ASC
    </select>

</mapper>